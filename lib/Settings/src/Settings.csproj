<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Syno.Settings</RootNamespace>
    <AssemblyName>Syno.Settings</AssemblyName>
    <PackageId>Syno.Settings</PackageId>
    <Version>0.1.0</Version>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(ComponentsRoot)' != ''">
    <ProjectReference Include="$(ComponentsRoot)\lib\Lucide\src\Lucide.csproj" />
  </ItemGroup>
  <Target Name="RequireComponents" BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(ComponentsRoot)\lib\Lucide\src\Lucide.csproj')">
    <Error Text="Set ComponentsRoot to the TinyTorrent2 checkout; see lib/Settings/README.md." />
  </Target>
</Project>
