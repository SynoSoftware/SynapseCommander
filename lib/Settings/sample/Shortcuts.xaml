<UserControl x:Class="SettingsSample.Shortcuts"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SettingsSample"
    xmlns:table="using:Syno.TableView">
    <UserControl.Resources>
        <DataTemplate x:Key="CommandCell" x:DataType="local:Shortcut">
            <TextBlock Text="{x:Bind Command}" VerticalAlignment="Center" />
        </DataTemplate>
        <DataTemplate x:Key="KeysCell" x:DataType="local:Shortcut">
            <TextBlock Text="{x:Bind Keys}" VerticalAlignment="Center" />
        </DataTemplate>
    </UserControl.Resources>
    <table:Table x:Name="Rows" Height="220" AutomationProperties.AutomationId="ShortcutsTable">
        <table:Table.Columns>
            <table:Column Id="command" DisplayName="Command" Width="300" CellTemplate="{StaticResource CommandCell}" />
            <table:Column Id="keys" DisplayName="Shortcut" Width="180" CellTemplate="{StaticResource KeysCell}" />
        </table:Table.Columns>
    </table:Table>
</UserControl>
